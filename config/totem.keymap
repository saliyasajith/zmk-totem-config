#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_sv.h" 

#define BASE 0
#define SYM  1
#define NUM  2
#define NAV  3
#define OPR  4
#define MOU  5

/* Mouse Speed Configuration */
&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <400>;                       
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        /* Diagonal Mouse Movement Macros */
        mupl: mouse_up_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mmv MOVE_UP &mmv MOVE_LEFT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_UP &mmv MOVE_LEFT>;
        };
        mupr: mouse_up_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mmv MOVE_UP &mmv MOVE_RIGHT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_UP &mmv MOVE_RIGHT>;
        };
        mdnl: mouse_down_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mmv MOVE_DOWN &mmv MOVE_LEFT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_DOWN &mmv MOVE_LEFT>;
        };
        mdnr: mouse_down_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mmv MOVE_DOWN &mmv MOVE_RIGHT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_DOWN &mmv MOVE_RIGHT>;
        };

        /* Standard Mac Screenshot (CMD+SHIFT+4) */
        screenshot: screenshot {
            label = "mac_screenshot";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>; // Time between each action
            tap-ms = <40>;  // How long each tap lasts
            bindings = <&macro_press &kp LGUI &kp LSHFT>, <&macro_tap &kp SV_N4>, <&macro_release &kp LGUI &kp LSHFT>;
        };

        /* Advanced Mac Screenshot (CMD+SHIFT+ALT+4) */
        screenshot_pro: screenshot_pro {
            label = "mac_screenshot_pro";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>; // Time between each action
            tap-ms = <40>;  // How long each tap lasts
            bindings =  <&macro_press &kp LGUI &kp LSHFT &kp LCTRL>, 
                        <&macro_tap &kp SV_N4>, 
                        <&macro_release &kp LGUI &kp LSHFT &kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_aa { timeout-ms = <50>; key-positions = <8 9>; bindings = <&kp SV_A_RING>; };
        combo_ae { timeout-ms = <50>; key-positions = <18 19>; bindings = <&kp SV_A_UMLAUT>; };
        combo_esc { timeout-ms = <50>; key-positions = <0 1>; bindings = <&kp ESC>; };
        combo_opr { timeout-ms = <50>; key-positions = <34 37>; bindings = <&mo OPR>; };
        combo_caps_word { timeout-ms = <50>; key-positions = <13 16>; bindings = <&caps_word>; };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp SV_Q      &kp SV_W      &kp SV_E       &kp SV_R        &kp SV_T               &kp SV_Y      &kp SV_U        &kp SV_I       &kp SV_O        &kp SV_P
                &hm LGUI SV_A &hm LCTRL SV_S &hm LALT SV_D &hm LSHFT SV_F  &kp SV_G               &kp SV_H      &hm RSHFT SV_J  &hm RALT SV_K &hm RCTRL SV_L  &hm RGUI SV_O_UMLAUT
&kp ESC         &kp SV_Z      &kp SV_X      &kp SV_C       &kp SV_V        &kp SV_B               &kp SV_N      &kp SV_M        &kp SV_COMMA   &kp SV_DOT      &kp SV_MINUS        &kp SV_APOS
                                            &kp RET        &lt MOU TAB     &lt NAV SPACE          &mo NUM       &kp BSPC        &mo SYM
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
                &kp SV_EXCL  &kp SV_DQT   &kp SV_HASH  &kp SV_EURO  &kp SV_PRCNT    &kp SV_AMPS  &kp SV_FSLH  &kp SV_LPAR  &kp SV_RPAR  &kp SV_EQUAL
                &kp SV_UNDER &kp SV_AT    &kp SV_POUND &kp SV_DLLR  &kp SV_SECT     &kp SV_STAR  &kp SV_PIPE  &kp SV_LBKT  &kp SV_RBKT  &kp SV_PLUS
&trans          &kp SV_LT    &kp SV_GT    &kp SV_TILDE &kp SV_CARET &kp SV_GRAVE    &kp SV_QMARK &kp SV_BSLH  &kp SV_LBRC  &kp SV_RBRC  &kp SV_MINUS &trans
                                          &trans       &trans       &trans          &trans       &trans       &trans
            >;
        };

        num_fn_layer {
            label = "NUM";
            bindings = <
                &kp F1      &kp F2      &kp F3      &kp F4      &kp F5          &kp F6      &kp F7      &kp F8      &kp F9      &kp F10
                &kp SV_N1   &kp SV_N2   &kp SV_N3   &kp SV_N4   &kp SV_N5       &kp SV_N6   &kp SV_N7   &kp SV_N8   &kp SV_N9   &kp SV_N0
&kp LSHFT       &kp F11     &kp F12     &trans      &trans      &trans          &trans      &trans      &trans      &trans      &trans     &trans
                                        &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

        nav_media_layer {
            label = "NAV";
            bindings = <
                &kp C_BRI_DN &kp C_BRI_UP &kp C_VOL_UP &kp C_PP    &kp C_MUTE      &trans      &trans      &kp UP      &trans      &trans
                &kp LGUI     &kp LCTRL    &kp LALT     &kp LSHFT   &kp C_VOL_DN    &trans      &kp LEFT    &kp DOWN    &kp RIGHT   &trans
&screenshot     &kp C_PREV   &kp C_NEXT   &kp C_STOP   &trans      &kp C_AC_SEARCH &trans      &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &trans
                                          &trans       &trans      &trans          &trans      &trans      &trans
            >;
        };

        opr_layer {
            label = "OPR";
            bindings = <
                &sys_reset   &bootloader  &bt BT_CLR   &bt BT_CLR_ALL &out OUT_TOG    &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans         &trans          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&trans          &trans       &trans       &trans       &trans         &trans          &trans       &trans       &trans       &trans       &trans       &trans
                                          &trans       &trans         &trans          &trans       &trans       &trans
            >;
        };

        mouse_layer {
            label = "MOU";
            bindings = <
                /* LEFT SIDE: Modifiers & Clicks */                 /* RIGHT SIDE: 8-Way Move & Scroll */
                &screenshot_pro &kp LSHFT   &kp SPACE    &mkp RCLK    &trans          &trans       &mupl           &mmv MOVE_UP    &mupr           &msc SCRL_DOWN
                &kp LGUI        &kp LCTRL   &kp LALT     &mkp LCLK    &mkp MB4        &msc SCRL_RIGHT &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &msc SCRL_LEFT
&kp ESC         &trans          &trans      &trans       &mkp MCLK    &mkp MB5        &trans       &mdnl           &mmv MOVE_DOWN   &mdnr           &msc SCRL_UP &trans
                                            &trans       &trans       &trans          &kp SPACE    &kp LCTRL       &trans
            >;
        };
    };
};